#!/bin/sh
# Crooli OS live-build configuration.
# Base: Debian 13 "trixie" (stable). Desktop: a minimal, pre-tuned GNOME, styled to the Crooli brand.
set -e

# Build for the machine we run on: amd64 (Intel/AMD PCs) or arm64 (Apple
# silicon VMs and ARM PCs). Override with CROOLI_ARCH=arm64 ./build.sh
ARCH="${CROOLI_ARCH:-$(dpkg --print-architecture)}"
case "$ARCH" in
	amd64) BOOTLOADERS="grub-efi syslinux" ;;
	arm64) BOOTLOADERS="grub-efi" ;;
	*) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

lb config noauto \
	--distribution trixie \
	--architectures "$ARCH" \
	--linux-flavours "$ARCH" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "http://deb.debian.org/debian/" \
	--mirror-binary "http://deb.debian.org/debian/" \
	--mirror-binary-security "http://security.debian.org/debian-security/" \
	--security true \
	--updates true \
	--apt-recommends false \
	--debian-installer none \
	--binary-images iso-hybrid \
	--bootloaders "$BOOTLOADERS" \
	--firmware-binary true \
	--firmware-chroot true \
	--memtest none \
	--iso-application "Crooli OS" \
	--iso-publisher "Crooli; https://crooli.com" \
	--iso-volume "Crooli OS 1.1.1" \
	--image-name "crooli-os-1.1.1" \
	--bootappend-live "boot=live components quiet splash loglevel=3 username=crooli hostname=crooli locales=en_US.UTF-8" \
	--chroot-squashfs-compression-type xz \
	--cache true \
	"${@}"
