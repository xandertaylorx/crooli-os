#!/bin/sh
# Called by the installer with the target root as $1. Installs the right
# GRUB packages (UEFI with Secure Boot, or legacy BIOS) from the copies the
# image carries in /usr/share/crooli/bootloader, so no internet is needed.
set -e

ROOT="$1"
[ -n "$ROOT" ] || { echo "usage: $0 TARGET_ROOT" >&2; exit 1; }

OURS=""
for fs in dev proc sys; do
	if ! mountpoint -q "$ROOT/$fs"; then
		mount --bind "/$fs" "$ROOT/$fs"
		OURS="$ROOT/$fs $OURS"
	fi
done

cleanup() {
	rm -rf "$ROOT/usr/share/crooli/bootloader"
	for m in $OURS; do umount "$m" 2>/dev/null || true; done
}
trap cleanup EXIT

ARCH=$(chroot "$ROOT" dpkg --print-architecture)
if [ -d /sys/firmware/efi ]; then
	SET=efi
	PACKAGES="grub-efi-$ARCH grub-efi-$ARCH-signed shim-signed"
else
	SET=bios
	PACKAGES="grub-pc"
fi

DEBS=$(cd "$ROOT" && ls usr/share/crooli/bootloader/$SET/*.deb 2>/dev/null | sed 's|^|/|')
if [ -n "$DEBS" ]; then
	DEBIAN_FRONTEND=noninteractive chroot "$ROOT" apt-get install -y \
		-o Dpkg::Options::="--force-confold" $DEBS
else
	DEBIAN_FRONTEND=noninteractive chroot "$ROOT" apt-get install -y \
		-o Dpkg::Options::="--force-confold" $PACKAGES
fi
