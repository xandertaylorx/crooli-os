#!/bin/sh
# Brand the system as Crooli OS and render bitmap icons from the SVG sources.
set -e

# --- Identity -------------------------------------------------------------
# Divert Debian's os-release so base-files upgrades don't undo it.
dpkg-divert --quiet --local --no-rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="Crooli OS 1.0.1"
NAME="Crooli OS"
VERSION_ID="1.0.1"
VERSION="1.0.1"
VERSION_CODENAME=trixie
ID=crooli
ID_LIKE=debian
LOGO=crooli-os
HOME_URL="https://os.crooli.com"
SUPPORT_URL="https://github.com/xandertaylorx/crooli-os/discussions"
BUG_REPORT_URL="https://github.com/xandertaylorx/crooli-os/issues"
EOF
ln -sf ../usr/lib/os-release /etc/os-release
printf '%s\n\n' 'Crooli OS 1.0.1 \n \l' > /etc/issue
echo "Crooli OS 1.0.1" > /etc/issue.net

# --- Bitmaps --------------------------------------------------------------
B=/usr/share/crooli
for size in 16 24 32 48 64 128 256 512; do
	dir=/usr/share/icons/hicolor/${size}x${size}/apps
	mkdir -p "$dir"
	rsvg-convert -w "$size" -h "$size" \
		/usr/share/icons/hicolor/scalable/apps/crooli-os.svg -o "$dir/crooli-os.png"
done
gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true

# Installer branding
C=/etc/calamares/branding/crooli
rsvg-convert -w 256 -h 256 /usr/share/icons/hicolor/scalable/apps/crooli-os.svg -o "$C/logo.png"
cp "$B/wordmark-installer.png" "$C/welcome.png"

# --- Boot splash ----------------------------------------------------------
rsvg-convert -w 128 -h 128 "$B/icon-white.svg" -o /usr/share/plymouth/themes/crooli/logo.png
plymouth-set-default-theme -R crooli

# --- Login screen ---------------------------------------------------------
# desktop-base (pulled in by GNOME) brands the login screen as Debian. Add
# our settings last in the greeter's own defaults so they win, then rebuild.
if [ -d /usr/share/gdm/dconf ]; then
	cp /etc/dconf/db/gdm.d/00-crooli /usr/share/gdm/dconf/99-crooli-settings
	dconf compile /usr/share/gdm/greeter-dconf-defaults /usr/share/gdm/dconf
fi

# --- Defaults that live in GSettings schemas (terminal palette)
glib-compile-schemas /usr/share/glib-2.0/schemas

# --- Fonts and desktop defaults ------------------------------------------
fc-cache -f >/dev/null
dconf update
