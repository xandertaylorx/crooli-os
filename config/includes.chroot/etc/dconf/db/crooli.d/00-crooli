# Crooli OS desktop defaults. Users can change any of these in Settings;
# this file only sets the starting point.

[org/gnome/desktop/interface]
font-name='Crooli Sans 11'
document-font-name='Crooli Sans 11'
monospace-font-name='JetBrains Mono 11'
icon-theme='Papirus-Dark'
cursor-size=24
font-antialiasing='rgba'
font-hinting='slight'
accent-color='blue'
color-scheme='prefer-dark'
clock-format='12h'
clock-show-weekday=true
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/crooli/crooli-os-light.svg'
picture-uri-dark='file:///usr/share/backgrounds/crooli/crooli-os-dark.svg'
picture-options='zoom'
primary-color='#0A0A0A'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/crooli/crooli-os-dark.svg'
primary-color='#0A0A0A'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'
titlebar-font='Crooli Sans Semi-Bold 11'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

[org/gnome/mutter]
center-new-windows=true
dynamic-workspaces=true
edge-tiling=true

[org/gnome/shell]
enabled-extensions=['crooli-theme@crooli.com', 'dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com']
favorite-apps=['crooli-install.desktop', 'firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Software.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='99'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
intellihide=false
extend-height=false
dash-max-icon-size=56
icon-size-fixed=true
height-fraction=0.9
show-trash=true
show-mounts=false
show-show-apps-button=true
show-apps-at-top=false
running-indicator-style='DOTS'
click-action='minimize-or-previews'
scroll-action='do-nothing'
apply-custom-theme=false
custom-theme-shrink=true
transparency-mode='FIXED'
background-color='#0A0A0A'
custom-background-color=true
background-opacity=0.72
disable-overview-on-startup=true

[org/gnome/nautilus/preferences]
default-folder-viewer='icon-view'
show-image-thumbnails='always'
date-time-format='simple'
open-folder-on-dnd-hover=true

[org/gnome/nautilus/icon-view]
default-zoom-level='medium'

[org/gnome/software]
download-updates=true
download-updates-notify=true
first-run=false
packaging-format-preference=['flatpak', 'deb']

[org/gnome/settings-daemon/plugins/power]
power-button-action='suspend'

[org/gnome/system/location]
enabled=false

[org/gnome/desktop/privacy]
report-technical-problems=false
send-software-usage-stats=false
remove-old-trash-files=true
remove-old-temp-files=true
old-files-age=uint32 30

[org/gnome/Ptyxis]
palette='crooli'
interface-style='dark'
use-system-font=false
font-name='JetBrains Mono 12'
default-columns=100
default-rows=28
restore-session=false
