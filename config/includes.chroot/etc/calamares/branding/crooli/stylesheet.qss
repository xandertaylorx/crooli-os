/* Crooli brand: Ink and Paper carry everything, Signal blue for actions.
   Everything starts dark, so no page can end up with light text on a light
   panel; the rules below only lift the few things that should stand out. */
QWidget {
    background-color: #0A0A0A;
    color: #EDEDED;
    font-family: "Crooli Sans";
    font-size: 11pt;
}

QLabel, QCheckBox, QRadioButton, QGroupBox, QStackedWidget, QSplitter, QToolBar {
    background-color: transparent;
}

QScrollArea, QAbstractScrollArea, QAbstractItemView, QListView, QTreeView,
QTableView, QPlainTextEdit, QTextEdit, QTextBrowser {
    background-color: #0F0F0F;
    color: #EDEDED;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    selection-background-color: #0A6CF0;
    selection-color: #FFFFFF;
}
QScrollArea > QWidget > QWidget { background-color: transparent; }

QDialog, QMessageBox { background-color: #141414; }

/* Checkboxes and radio buttons: a visible square or circle, filled blue when on. */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6F6F6F;
    background-color: #171717;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 9px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3291FF;
    border-color: #3291FF;
}

/* The partition legend draws its names in black, so give it a light card. */
PartitionLabelsView {
    background-color: #EDEDED;
    color: #0A0A0A;
    border: none;
    border-radius: 8px;
}

QPushButton, QToolButton {
    background-color: #171717;
    color: #EDEDED;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 8px 18px;
}
QPushButton:hover, QToolButton:hover { background-color: #222222; }
QPushButton:default, #view-button-next {
    background-color: #FFFFFF;
    color: #0A0A0A;
    border: none;
}
QPushButton:disabled, QToolButton:disabled { color: #6F6F6F; }

QLineEdit, QComboBox {
    background-color: #171717;
    color: #EDEDED;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    padding: 6px;
    selection-background-color: #0A6CF0;
}
QLineEdit:focus, QComboBox:focus { border-color: #3291FF; }
QComboBox QAbstractItemView {
    background-color: #171717;
    border: 1px solid #2A2A2A;
}

QProgressBar {
    background-color: #171717;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #3291FF;
    border-radius: 4px;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #2A2A2A; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QToolTip { background-color: #171717; color: #EDEDED; border: 1px solid #2A2A2A; }
